<?php
session_start();
error_reporting(E_ALL);
ini_set('display_errors', 0);

require_once 'Inventario/crud/includes/db.php';
require_once __DIR__ . '/includes/password_reset_functions.php';

$token = $_GET['token'] ?? '';
$message = '';
$messageType = ''; // 'success' o 'error'
$showForm = false;
$tokenData = null;

// Validar token al cargar la página
if (!empty($token)) {
    $tokenData = validateResetToken($token, $conn);
    
    if ($tokenData) {
        $showForm = true;
    } else {
        $message = 'El link de recuperación no es válido o ha expirado. Por favor, solicita uno nuevo.';
        $messageType = 'error';
    }
} else {
    $message = 'No se proporcionó un token de recuperación válido.';
    $messageType = 'error';
}

// Procesar cambio de contraseña
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'reset_password') {
    try {
        $token = trim($_POST['token'] ?? '');
        $newPassword = trim($_POST['new_password'] ?? '');
        $confirmPassword = trim($_POST['confirm_password'] ?? '');
        
        if (empty($token) || empty($newPassword) || empty($confirmPassword)) {
            throw new Exception('Por favor, completa todos los campos.');
        }
        
        // Re-validar token
        $tokenData = validateResetToken($token, $conn);
        if (!$tokenData) {
            throw new Exception('El token de recuperación no es válido o ha expirado. Por favor, solicita uno nuevo.');
        }
        
        // Validar contraseña
        if (strlen($newPassword) < 8) {
            throw new Exception('La contraseña debe tener al menos 8 caracteres.');
        }
        
        // Validar complejidad (al menos una letra y un número)
        if (!preg_match('/[a-zA-Z]/', $newPassword) || !preg_match('/[0-9]/', $newPassword)) {
            throw new Exception('La contraseña debe contener al menos una letra y un número.');
        }
        
        // Verificar que las contraseñas coincidan
        if ($newPassword !== $confirmPassword) {
            throw new Exception('Las contraseñas no coinciden.');
        }
        
        // Hash de la nueva contraseña
        $passwordHash = password_hash($newPassword, PASSWORD_DEFAULT);
        
        // Actualizar contraseña
        $stmt = $conn->prepare('UPDATE usuarios SET contraseña = ? WHERE id_usuario = ?');
        if (!$stmt) {
            throw new Exception('Error al preparar la consulta: ' . $conn->error);
        }
        
        $stmt->bind_param('si', $passwordHash, $tokenData['id_usuario']);
        if (!$stmt->execute()) {
            throw new Exception('Error al actualizar la contraseña: ' . $stmt->error);
        }
        
        // Marcar token como usado
        $tokenHash = hash('sha256', $token);
        markTokenAsUsed($tokenHash, $conn);
        
        // Invalidar otros tokens pendientes del usuario
        invalidateUserTokens($tokenData['id_usuario'], $conn);
        
        error_log('[Password Reset] Contraseña restablecida exitosamente para usuario ID: ' . $tokenData['id_usuario']);
        
        $message = 'Tu contraseña ha sido restablecida exitosamente. Puedes iniciar sesión con tu nueva contraseña.';
        $messageType = 'success';
        $showForm = false;
        
        // Redirigir después de 3 segundos
        header('Refresh: 3; url=index.php');
        
    } catch (Exception $e) {
        error_log('[Password Reset] Error al restablecer contraseña: ' . $e->getMessage());
        $message = $e->getMessage();
        $messageType = 'error';
        
        // Re-validar token para mostrar formulario si aún es válido
        if (!empty($token)) {
            $tokenData = validateResetToken($token, $conn);
            $showForm = ($tokenData !== null);
        }
    }
}
?>
