# Copia este archivo como .env y completa los valores (Meta WhatsApp Cloud API)

WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# Opcional: App Secret de Meta (recomendado para validar firma del webhook)
WHATSAPP_APP_SECRET=

# Empresa por defecto para tickets creados desde WhatsApp (id_empresa en tickets)
WHATSAPP_DEFAULT_EMPRESA_ID=

# Opcional: id del modo de contacto "WhatsApp" en contact_modes
WHATSAPP_CONTACT_MODE_ID=
# Ejemplo: https://tudominio.com/whatsapp/webhook.php
